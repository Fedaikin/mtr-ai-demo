# PostgreSQL/Neon is mandatory for durable Preview and Production deployments.
DATABASE_URL=

# Optional in local development. Required for uploads on Vercel.
BLOB_READ_WRITE_TOKEN=

LLM_PROVIDER=mock
LLM_API_KEY=
APP_MODE=demo
DEMO_USER_ID=demo-user-001

# Local-only PostgreSQL-compatible PGlite fallback.
PGLITE_DATA_DIR=.data/pglite

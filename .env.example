# PostgreSQL/Neon is mandatory for durable Preview and Production deployments.
DATABASE_URL=

# Optional in local development. Required for uploads on Vercel.
BLOB_READ_WRITE_TOKEN=

LLM_PROVIDER=mock
LLM_API_KEY=
# Provider-level emergency stop; only explicit false disables provider calls.
MTR_AGENT_LLM_ENABLED=true
APP_MODE=demo
DEMO_USER_ID=demo-user-001
# Provide a scrypt hash through the environment secret manager. Never publish
# the plaintext password or commit the real hash to an environment file.
DEMO_PASSWORD_HASH=

# Orchestrator features are fail-closed until explicitly enabled.
MTR_AGENT_ORCHESTRATOR_ENABLED=false
MTR_AGENT_ACTIONS_ENABLED=false
MTR_AGENT_EVENTS_ENABLED=false
MTR_AGENT_UNIVERSAL_CHAT_ENABLED=false
MTR_AGENT_KILL_SWITCH=false
# Required only for the service-to-service event ingress; minimum 32 characters.
MTR_AGENT_EVENT_INGRESS_SECRET=

# Local-only PostgreSQL-compatible PGlite fallback.
PGLITE_DATA_DIR=.data/pglite
